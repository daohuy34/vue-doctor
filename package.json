{
  "name": "vue-doctor",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "vue-doctor": "./bin/vue-doctor.js"
  },
  "scripts": {
    "build": "tsup src/cli/index.ts --format esm,cjs --dts --out-dir dist",
    "dev": "tsx src/cli/index.ts check",
    "check": "tsx src/cli/index.ts check",
    "test": "vitest"
  },
  "dependencies": {
    "@vue/compiler-sfc": "^3.5.13",
    "cac": "^6.7.14",
    "chalk": "^5.4.1",
    "fast-glob": "^3.3.3",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}